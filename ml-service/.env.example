# FarmSync ML Service — copy to .env before running locally.
# NEVER commit .env to version control.

# ===========================================================================
# REQUIRED
# ===========================================================================

# Shared secret between the ml-service and the backend.
# Must match ML_SERVICE_SECRET in backend/.env
ML_SERVICE_SECRET=change-me-to-a-long-random-secret

# ===========================================================================
# OPTIONAL — Defaults work for local development
# ===========================================================================

# Frontend URL allowed for CORS (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Redis URL for caching (if Redis is available; falls back to in-memory cache)
# REDIS_URL=redis://localhost:6379

# ML service host and port
# HOST=0.0.0.0
# PORT=8000
