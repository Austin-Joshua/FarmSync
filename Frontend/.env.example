# FarmSync Frontend - API connection
# Copy to .env and adjust if your backend runs on a different host/port

# Backend API base URL (must include /api)
VITE_API_URL=http://localhost:5001/api

# Optional: OAuth (if using Google/Apple/Microsoft sign-in)
# VITE_GOOGLE_CLIENT_ID=
# VITE_APPLE_CLIENT_ID=
# VITE_APPLE_TEAM_ID=
# VITE_MICROSOFT_CLIENT_ID=
