# FarmSync Frontend - API connection
# Copy to .env only if you need to override the default.

# In dev (npm run dev): frontend uses Vite proxy to Backend (no .env needed).
# Backend must run on http://localhost:9090 (see QUICK_START.md).

# Override only if backend runs elsewhere (must include /api):
# VITE_API_URL=http://localhost:9090/api

# Firebase Web configuration (Required for Auth & Firestore)
# You can find these in the Firebase Console (Project Settings > Your Apps).
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=lunar-db-10d04.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lunar-db-10d04
VITE_FIREBASE_STORAGE_BUCKET=lunar-db-10d04.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Optional: OAuth (if using Google/Apple/Microsoft sign-in)
# VITE_GOOGLE_CLIENT_ID=
# VITE_APPLE_CLIENT_ID=
# VITE_APPLE_TEAM_ID=
# VITE_MICROSOFT_CLIENT_ID=
