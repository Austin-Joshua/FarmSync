# FarmSync Backend — copy to .env or set in your shell / Render dashboard.
# NEVER commit real secrets to version control.

# ===========================================================================
# REQUIRED — Application will refuse to start or operate correctly without these
# ===========================================================================

# JWT secret — minimum 64 random characters. Generate with: openssl rand -base64 64
JWT_SECRET=FARMSYNC_LOCAL_DEV_SECRET_CHANGE_IN_PRODUCTION_MIN_64_CHARS_REQUIRED_HERE

# Shared secret between the backend and the ml-service (must match ML_SERVICE_SECRET in ml-service/.env)
ML_SERVICE_SECRET=change-me-to-a-long-random-secret

# ===========================================================================
# GENERAL CONFIGURATION
# ===========================================================================

# Server port (default: 9090)
PORT=9090

# Spring profile (dev enables DataInitializer; prod is the safe default)
SPRING_PROFILES_ACTIVE=dev

# Enable demo data seeding (requires SPRING_PROFILES_ACTIVE=dev)
SEED_DEMO_DATA=true

# Frontend URL for CORS (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# FastAPI ML Service URL
ML_SERVICE_URL=http://localhost:8000

# ===========================================================================
# DATABASE CONFIGURATION
# ===========================================================================

# H2 File-based (default) or PostgreSQL settings
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/farmsync;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver

# JPA/Hibernate configurations
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.H2Dialect

# Connection Pooling
HIKARI_MAX_POOL_SIZE=4
HIKARI_MIN_IDLE=1

# H2 web console — only enable for local dev debugging (NEVER in production)
H2_CONSOLE_ENABLED=false

# ===========================================================================
# THIRD PARTY INTEGRATIONS & SECURITY
# ===========================================================================

# Firebase service account path
FIREBASE_CONFIG_PATH=firebase-service-account.json

# OAuth2 — Google
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# OAuth2 — Microsoft (Azure AD)
MICROSOFT_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-oauth-client-secret

# Sentry DSN for Error Tracking
SENTRY_DSN=

# ===========================================================================
# LOGGING CONFIGURATIONS
# ===========================================================================
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_APP=INFO
